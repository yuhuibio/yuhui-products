---
// src/layouts/Layout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string; // 1. 允许外部传入分享图片
}

// 2. 接收传进来的参数，如果没有就用默认值
const { 
  title = "Xian Yuhuibio - Essential Oils Manufacturer", 
  description = "Premium essential oils supplier and manufacturer from China. Bulk essential oils, carrier oils, and botanical extracts.",
  image = "/images/default-share.jpg" // 默认分享图，建议在 public/images/ 下准备一张
} = Astro.props;

// 3. 核心：自动根据当前访问的路径，生成绝对规范路径 (Canonical URL)
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// 4. 生成绝对路径的分享图片 URL（社交媒体抓取需要绝对地址）
const socialImageURL = new URL(image, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- 动态标题 -->
    <title>{title}</title>

    <!-- 动态描述 -->
    <meta name="description" content={description} />

    <!-- ⭐ 核心：规范标签 -->
    <link rel="canonical" href={canonicalURL} />

    <!-- ⭐ Open Graph / Facebook / LinkedIn / WhatsApp 社交媒体分享标签 -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- ⭐ X (Twitter) Card 分享标签 -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- ⭐ Favicon（保留你的原配置） -->
    <link rel="icon" type="image/png" href="/favicon-v2.png?v=1" />
    <link rel="shortcut icon" href="/favicon-v2.png?v=1" />
    <link rel="apple-touch-icon" href="/favicon-v2.png?v=1" />

    <!-- ⭐ 浏览器主题色 -->
    <meta name="theme-color" content="#4a5d4e" />
  </head>

  <body class="bg-[#f8f7f4] text-[#4a5d4e] font-sans min-h-screen flex flex-col">
    
    <!-- 顶部导航 -->
    <Header />

    <!-- 页面主体内容区域 -->
    <main class="flex-grow">
      <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
        <slot />
      </div>
    </main>

    <!-- 底部页脚 -->
    <Footer />

  </body>
</html>