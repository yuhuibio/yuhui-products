---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: posts[index - 1] || null,
      nextPost: posts[index + 1] || null
    },
  }));
}
const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();
// 根据 topics 标签匹配相关文章
const allPosts = await getCollection('blog');
const currentTopics = post.data.topics ?? [];
const relatedPosts = allPosts
  .filter((candidate) => candidate.slug !== post.slug)
  .map((candidate) => ({
    post: candidate,
    sharedTopics: currentTopics.filter((topic) =>
      (candidate.data.topics ?? []).includes(topic)
    ).length
  }))
  .filter((item) => item.sharedTopics > 0)
  .sort((a, b) =>
    b.sharedTopics - a.sharedTopics ||
    b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
  )
  .slice(0, 3);
---
<Layout title={post.data.title}>
  <div class="bg-white min-h-screen">
    <div class="max-w-7xl mx-auto px-6 py-16 lg:py-20 lg:flex gap-12 xl:gap-16">
      <!-- Sticky侧边栏，极简，无多余背景 -->
      <aside class="lg:w-64 xl:w-72 lg:flex-shrink-0 order-2 lg:order-1 mt-12 lg:mt-0">
        <div class="lg:sticky lg:top-10">
          <BlogSidebar />
        </div>
      </aside>

      <!-- 主内容区：无外层大卡片！纯留白排版 -->
      <main class="flex-grow min-w-0 order-1 lg:order-2">
        <div class="max-w-3xl">
          <article>
            <!-- 文章头部，极简，不花哨 -->
            <header class="mb-14">
              {post.data.category && (
                <p class="text-sm font-medium text-[#4a5d4e] mb-4">
                  {post.data.category}
                </p>
              )}
              <h1 class="text-4xl sm:text-5xl font-semibold text-slate-900 leading-[1.15] tracking-tight mb-6">
                {post.data.title}
              </h1>
              <div class="text-sm text-slate-500">
                <span>Author: {post.data.author}</span>
                <span class="mx-2">|</span>
                <span>Published: {post.data.pubDate.toLocaleDateString()}</span>
                {currentTopics.length > 0 && (
                  <>
                    <span class="mx-2">|</span>
                    <span>{currentTopics.join(', ')}</span>
                  </>
                )}
              </div>
            </header>

            <!-- Markdown正文，干净prose，去掉多余装饰 -->
            <div
              class="prose prose-base lg:prose-base max-w-none
              prose-headings:font-semibold
              prose-h2:text-2xl prose-h2:mt-14 prose-h2:mb-5 prose-h2:text-slate-900
              prose-h3:text-xl prose-h3:mt-10 prose-h3:mb-4 prose-h3:text-slate-900
              prose-p:text-slate-700 prose-p:leading-relaxed
              prose-a:text-[#4a5d4e] hover:prose-a:text-[#3b4c3e] hover:prose-a:no-underline
              prose-strong:text-slate-900
              prose-blockquote:border-l-[#4a5d4e] prose-blockquote:text-slate-600
              prose-img:rounded-md
              prose-code:text-[#4a5d4e] prose-code:bg-slate-50 prose-code:px-1 prose-code:rounded
              prose-pre:bg-slate-900 prose-pre:text-slate-100 prose-pre:rounded-md"
            >
              <Content />
            </div>
          </article>

          <!-- Related Articles：无卡片，纯文字+细边框底部，极简列表式 -->
          {relatedPosts.length > 0 && (
            <section class="mt-20 pt-12 border-t border-slate-200">
              <h2 class="text-xl font-semibold text-slate-900 mb-8">Related Articles</h2>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {relatedPosts.map(({ post: related }) => (
                  <article>
                    <p class="text-sm text-[#4a5d4e] font-medium mb-2">{related.data.category}</p>
                    <h3 class="text-lg font-semibold mb-3">
                      <a
                        href={`/blog/${related.slug}`}
                        class="text-slate-900 hover:text-[#4a5d4e] transition-colors"
                      >
                        {related.data.title}
                      </a>
                    </h3>
                    <p class="text-sm text-slate-600">{related.data.description}</p>
                    <a
                      href={`/blog/${related.slug}`}
                      class="inline-block mt-4 text-sm font-medium text-[#4a5d4e] hover:text-[#3b4c3e]"
                    >
                      Read Article →
                    </a>
                  </article>
                ))}
              </div>
            </section>
          )}

          <!-- 上下篇导航：去掉卡片，左右文字布局，细分割线 -->
          <nav class="mt-20 pt-12 border-t border-slate-200">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
              <div>
                {prevPost && (
                  <a href={`/blog/${prevPost.slug}`} class="group block">
                    <span class="text-sm text-slate-500">← Previous</span>
                    <p class="mt-2 text-lg font-semibold text-slate-900 group-hover:text-[#4a5d4e] transition-colors">
                      {prevPost.data.title}
                    </p>
                  </a>
                )}
              </div>
              <div class="text-right">
                {nextPost && (
                  <a href={`/blog/${nextPost.slug}`} class="group block">
                    <span class="text-sm text-slate-500">Next →</span>
                    <p class="mt-2 text-lg font-semibold text-slate-900 group-hover:text-[#4a5d4e] transition-colors">
                      {nextPost.data.title}
                    </p>
                  </a>
                )}
              </div>
            </div>
          </nav>
        </div>
      </main>
    </div>
  </div>
</Layout>
