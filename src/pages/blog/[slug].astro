---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: posts[index - 1] || null,
      nextPost: posts[index + 1] || null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();

// 根据 topics 标签匹配相关文章
const allPosts = await getCollection('blog');
const currentTopics = post.data.topics ?? [];

const relatedPosts = allPosts
  .filter((candidate) => candidate.slug !== post.slug)
  .map((candidate) => ({
    post: candidate,
    sharedTopics: currentTopics.filter((topic) =>
      (candidate.data.topics ?? []).includes(topic)
    ).length,
  }))
  .filter((item) => item.sharedTopics > 0)
  .sort(
    (a, b) =>
      b.sharedTopics - a.sharedTopics ||
      b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
  )
  .slice(0, 2); // 改为展示 2 篇，保持网格整洁
---

<Layout title={post.data.title}>
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-12">
      
      <!-- 侧边栏：在移动端隐藏或置顶，大屏下固定宽度 -->
      <aside class="hidden lg:block lg:w-64 flex-shrink-0">
        <div class="sticky top-8">
          <BlogSidebar />
        </div>
      </aside>

      <!-- 文章主体内容区 -->
      <main class="flex-grow min-w-0 max-w-3xl mx-auto lg:mx-0">
        
        <!-- 文章头部元信息 -->
        <header class="mb-8 pb-8 border-b border-gray-100">
          <div class="flex items-center gap-2 text-sm text-[#4a5d4e] font-medium mb-3">
            <span>{post.data.category || 'Tech & Life'}</span>
            <span>•</span>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight leading-tight">
            {post.data.title}
          </h1>
          {post.data.author && (
            <p class="mt-4 text-sm text-gray-500">
              By <span class="font-medium text-gray-700">{post.data.author}</span>
            </p>
          )}
        </header>

        <!-- Markdown 文章正文 -->
        <article class="prose prose-lg max-w-none text-gray-700 
          prose-headings:text-gray-900 prose-headings:font-bold 
          prose-a:text-[#4a5d4e] prose-a:no-underline hover:prose-a:underline
          prose-img:rounded-xl prose-img:shadow-md">
          <Content />
        </article>

        <!-- 相关文章推荐 -->
        {relatedPosts.length > 0 && (
          <section class="mt-16 pt-10 border-t border-gray-100">
            <h2 class="text-xl font-bold text-gray-900 mb-6">
              相关文章推荐
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {relatedPosts.map(({ post: related }) => (
                <div class="group relative bg-white border border-gray-200/80 rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-[#4a5d4e]/50 transition-all duration-300 flex flex-col justify-between">
                  <div>
                    <span class="inline-block text-xs font-semibold text-[#4a5d4e] bg-[#4a5d4e]/10 px-2.5 py-1 rounded-full mb-3">
                      {related.data.category || 'Article'}
                    </span>
                    <h3 class="text-base font-bold text-gray-900 group-hover:text-[#4a5d4e] transition-colors line-clamp-2 mb-2">
                      <a href={`/blog/${related.slug}`}>
                        <span class="absolute inset-0"></span>
                        {related.data.title}
                      </a>
                    </h3>
                    <p class="text-sm text-gray-500 line-clamp-2 leading-relaxed">
                      {related.data.description}
                    </p>
                  </div>
                  <div class="mt-4 pt-4 border-t border-gray-50 flex items-center text-xs font-semibold text-[#4a5d4e]">
                    阅读文章 →
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- 底部上下篇导航 -->
        <nav class="mt-16 pt-8 border-t border-gray-100 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="flex flex-col">
            {prevPost && (
              <a
                href={`/blog/${prevPost.slug}`}
                class="group p-4 rounded-xl border border-gray-100 hover:border-[#4a5d4e]/40 hover:bg-gray-50/50 transition-all"
              >
                <span class="text-xs text-gray-400 block mb-1">← 上一篇</span>
                <span class="text-sm font-semibold text-gray-800 group-hover:text-[#4a5d4e] line-clamp-1">
                  {prevPost.data.title}
                </span>
              </a>
            )}
          </div>
          <div class="flex flex-col text-right">
            {nextPost && (
              <a
                href={`/blog/${nextPost.slug}`}
                class="group p-4 rounded-xl border border-gray-100 hover:border-[#4a5d4e]/40 hover:g-gray-50/50 transition-all"
              >
                <span class="text-xs text-gray-400 block mb-1">下一篇 →</span>
                <span class="text-sm font-semibold text-gray-800 group-hover:text-[#4a5d4e] line-clamp-1">
                  {nextPost.data.title}
                </span>
              </a>
            )}
          </div>
        </nav>

      </main>
    </div>
  </div>
</Layout>