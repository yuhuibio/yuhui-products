
---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: posts[index - 1] || null,
      nextPost: posts[index + 1] || null
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();

// 根据 topics 标签匹配相关文章
const allPosts = await getCollection('blog');
const currentTopics = post.data.topics ?? [];

const relatedPosts = allPosts
  .filter((candidate) => candidate.slug !== post.slug)
  .map((candidate) => ({
    post: candidate,
    sharedTopics: currentTopics.filter((topic) =>
      (candidate.data.topics ?? []).includes(topic)
    ).length
  }))
  .filter((item) => item.sharedTopics > 0)
  .sort((a, b) =>
    b.sharedTopics - a.sharedTopics ||
    b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
  )
  .slice(0, 3);
---

<Layout title={post.data.title}>
  <div class="max-w-7xl mx-auto py-12 px-6 flex gap-8">
    <!-- 侧边栏 -->
    <BlogSidebar />

    <!-- 文章主体 -->
    <main class="flex-grow min-w-0">
      <article
        class="prose prose-base lg:prose-base mx-auto
               prose-headings:font-semibold
               prose-headings:leading-snug
               prose-headings:mt-12
               prose-headings:mb-8
               prose-headings:text-3xl"
      >
        <h1>{post.data.title}</h1>

        <p class="text-sm text-gray-500">
          Author: {post.data.author} |
          Published: {post.data.pubDate.toLocaleDateString()}
        </p>

        <Content />
      </article>

      <!-- Related Articles -->
      {relatedPosts.length > 0 && (
        <section class="mt-16 pt-8 border-t border-gray-200">
          <h2 class="text-2xl font-semibold text-gray-800 mb-6">
            Related Articles
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {relatedPosts.map(({ post: related }) => (
              <article class="border border-gray-200 rounded-lg p-5 hover:border-[#4a5d4e] transition-colors">
                <p class="text-sm text-gray-500 mb-2">
                  {related.data.category}
                </p>

                <h3 class="text-lg font-semibold leading-snug mb-3">
                  <a
                    href={`/blog/${related.slug}`}
                    class="text-[#4a5d4e] hover:underline"
                  >
                    {related.data.title}
                  </a>
                </h3>

                <p class="text-sm text-gray-600 leading-relaxed">
                  {related.data.description}
                </p>

                <a
                  href={`/blog/${related.slug}`}
                  class="inline-block mt-4 text-sm font-semibold text-[#4a5d4e] hover:underline"
                >
                  Read Article →
                </a>
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- 底部导航 -->
      <nav class="mt-16 pt-8 border-t flex justify-between gap-4">
        <div>
          {prevPost && (
            <a
              href={`/blog/${prevPost.slug}`}
              class="text-[#4a5d4e] font-bold"
            >
              ← Prev: {prevPost.data.title}
            </a>
          )}
        </div>

        <div class="text-right">
          {nextPost && (
            <a
              href={`/blog/${nextPost.slug}`}
              class="text-[#4a5d4e] font-bold"
            >
              Next: {nextPost.data.title} →
            </a>
          )}
        </div>
      </nav>
    </main>
  </div>

  <style>
    .prose h1 {
      line-height: 1.2 !important;
      margin-bottom: 2rem !important;
      margin-top: 1rem !important;
    }
  </style>
</Layout>
