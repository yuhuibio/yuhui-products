
---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  const sortedPosts = [...posts].sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return sortedPosts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      // 日期较早的文章作为上一篇，日期较新的文章作为下一篇
      prevPost: sortedPosts[index + 1] || null,
      nextPost: sortedPosts[index - 1] || null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();

const allPosts = await getCollection('blog');
const currentTopics = post.data.topics ?? [];

// 根据共同 topics 匹配相关文章，展示全部匹配结果
const relatedPosts = allPosts
  .filter((candidate) => candidate.slug !== post.slug)
  .map((candidate) => ({
    post: candidate,
    sharedTopics: currentTopics.filter((topic) =>
      (candidate.data.topics ?? []).includes(topic)
    ).length,
  }))
  .filter((item) => item.sharedTopics > 0)
  .sort(
    (a, b) =>
      b.sharedTopics - a.sharedTopics ||
      b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
  );

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={post.data.title}>
  <div class="blog-page">
    <div class="blog-shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/blog/">Insights</a>
        <span>/</span>
        <span class="breadcrumb-current">
          {post.data.category || 'Botanical Insights'}
        </span>
      </nav>

      <div class="blog-layout">
        <aside class="sidebar-column">
          <div class="sidebar-sticky">
            <div class="sidebar-heading">
              <span class="sidebar-kicker">EXPLORE</span>
              <h2>Our Insights</h2>
              <p>Knowledge for botanical ingredient professionals.</p>
            </div>
            <BlogSidebar />
          </div>
        </aside>

        <main class="article-main">
          <header class="article-header">
            <div class="article-meta-top">
              <span class="article-category">
                {post.data.category || 'Botanical Ingredients'}
              </span>
              <span class="meta-dot" aria-hidden="true"></span>
              <time datetime={post.data.pubDate.toISOString()}>
                {formattedDate}
              </time>
            </div>

            <h1>{post.data.title}</h1>

            {post.data.description && (
              <p class="article-deck">{post.data.description}</p>
            )}

            <div class="article-byline">
              {post.data.author && (
                <span>
                  By <strong>{post.data.author}</strong>
                </span>
              )}
              <span class="byline-divider" aria-hidden="true"></span>
              <span>Botanical Ingredients &amp; Industry Insights</span>
            </div>
          </header>

          <article class="article-content">
            <Content />
          </article>

          {relatedPosts.length > 0 && (
            <section class="related-section" aria-labelledby="related-title">
              <div class="related-heading">
                <div class="related-heading-copy">
                  <p class="related-eyebrow">CONTINUE EXPLORING</p>
                  <h2 id="related-title">Related Articles</h2>
                  <p class="related-subtitle">
                    Explore more insights on botanical ingredients and essential oils.
                  </p>
                </div>

                <div class="related-controls">
                  <button
                    type="button"
                    class="related-arrow"
                    aria-label="Scroll articles left"
                    data-scroll="left"
                  >
                    <span aria-hidden="true">←</span>
                  </button>
                  <button
                    type="button"
                    class="related-arrow"
                    aria-label="Scroll articles right"
                    data-scroll="right"
                  >
                    <span aria-hidden="true">→</span>
                  </button>
                </div>
              </div>

              <div class="related-track" tabindex="0" aria-label="Related articles">
                {relatedPosts.map(({ post: related }) => (
                  <article class="related-card">
                    <a
                      href={`/blog/${related.slug}`}
                      class="related-image-link"
                      aria-label={`Read ${related.data.title}`}
                    >
                      {related.data.img ? (
  <img
    src={related.data.img}
    alt={related.data.title}
    loading="lazy"
    decoding="async"
    width="640"
    height="400"
  />
) : (
  <div class="related-image-placeholder">
    <span>BOTANICAL INSIGHTS</span>
  </div>
)}
                    </a>

                    <div class="related-card-body">
                      <p class="related-category">
                        {related.data.category || 'Botanical Ingredients'}
                      </p>

                      <h3>
                        <a href={`/blog/${related.slug}`}>
                          {related.data.title}
                        </a>
                      </h3>

                      {related.data.description && (
                        <p class="related-description">
                          {related.data.description}
                        </p>
                      )}

                      <a
                        href={`/blog/${related.slug}`}
                        class="related-read-more"
                      >
                        Read Article <span aria-hidden="true">→</span>
                      </a>
                    </div>
                  </article>
                ))}
              </div>

              <p class="related-scroll-hint">
                Scroll horizontally to explore more articles →
              </p>
            </section>
          )}

          <nav class="post-navigation" aria-label="Article navigation">
            <div class="post-navigation-item">
              {prevPost && (
                <a href={`/blog/${prevPost.slug}`} class="post-nav-link">
                  <span class="post-nav-label">← PREVIOUS ARTICLE</span>
                  <span class="post-nav-title">{prevPost.data.title}</span>
                </a>
              )}
            </div>

            <div class="post-navigation-item post-navigation-next">
              {nextPost && (
                <a href={`/blog/${nextPost.slug}`} class="post-nav-link">
                  <span class="post-nav-label">NEXT ARTICLE →</span>
                  <span class="post-nav-title">{nextPost.data.title}</span>
                </a>
              )}
            </div>
          </nav>
        </main>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll('.related-section').forEach((section) => {
      const track = section.querySelector('.related-track');
      const leftButton = section.querySelector('[data-scroll="left"]');
      const rightButton = section.querySelector('[data-scroll="right"]');

      if (!track || !leftButton || !rightButton) return;

      const getScrollAmount = () => {
        const card = track.querySelector('.related-card');
        if (!card) return 320;

        const trackStyle = getComputedStyle(track);
        const gap = parseFloat(trackStyle.columnGap) || 0;

        return card.getBoundingClientRect().width + gap;
      };

      leftButton.addEventListener('click', () => {
        track.scrollBy({
          left: -getScrollAmount(),
          behavior: 'smooth',
        });
      });

      rightButton.addEventListener('click', () => {
        track.scrollBy({
          left: getScrollAmount(),
          behavior: 'smooth',
        });
      });
    });
  </script>

  <style>
    .blog-page {
      --forest: #354c3d;
      --forest-dark: #26392d;
      --sage: #788a72;
      --paper: #fbfaf7;
      --line: #e7e7df;
      background: var(--paper);
      color: #30352f;
      min-height: 100vh;
    }

    .blog-shell {
      width: min(1440px, 100%);
      margin-inline: auto;
      padding: 2rem 2.5rem 5rem;
    }

    .breadcrumb {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 2.25rem;
      color: #85877e;
      font-size: 0.78rem;
    }

    .breadcrumb a {
      color: #687765;
      text-decoration: none;
    }

    .breadcrumb a:hover {
      color: var(--forest-dark);
    }

    .breadcrumb-current {
      color: #4c554b;
    }

    .blog-layout {
      display: grid;
      grid-template-columns: 220px minmax(0, 820px);
      align-items: start;
      gap: clamp(2.5rem, 5vw, 5.5rem);
    }

    .sidebar-column {
      min-width: 0;
    }

    .sidebar-sticky {
      position: sticky;
      top: 2rem;
    }

    .sidebar-heading {
      padding: 0 0 1.25rem;
      margin-bottom: 1.25rem;
      border-bottom: 1px solid var(--line);
    }

    .sidebar-kicker {
      color: var(--sage);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.16em;
    }

    .sidebar-heading h2 {
      margin: 0.5rem 0;
      color: var(--forest-dark);
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 1.5rem;
      font-weight: 600;
    }

    .sidebar-heading p {
      margin: 0;
      color: #777b72;
      font-size: 0.82rem;
      line-height: 1.7;
    }

    .article-main {
      min-width: 0;
      width: 100%;
    }

    .article-header {
      padding: 0 0 2rem;
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--line);
    }

    .article-meta-top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.7rem;
      margin-bottom: 1.4rem;
      color: #81847a;
      font-size: 0.78rem;
    }

    .article-category {
      color: var(--forest);
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    .meta-dot {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: #a3a69b;
    }

    .article-header h1 {
      margin: 0;
      color: var(--forest-dark);
      font-family: Georgia, 'Times New Roman', serif;
      font-size: clamp(1.85rem, 3vw, 2.65rem);
      font-weight: 500;
      letter-spacing: -0.025em;
      line-height: 1.25;
      text-wrap: balance;
    }

    .article-deck {
      margin: 1.35rem 0 0;
      color: #6c7168;
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 1.15rem;
      line-height: 1.8;
    }

    .article-byline {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.7rem;
      margin-top: 1.5rem;
      color: #777b72;
      font-size: 0.78rem;
    }

    .article-byline strong {
      color: #414a40;
      font-weight: 600;
    }

    .byline-divider {
      width: 1px;
      height: 13px;
      background: #d6d8cf;
    }

    .article-content {
      min-width: 0;
      color: #41473f;
      font-size: 1.04rem;
      line-height: 1.9;
      overflow-wrap: anywhere;
    }

    .article-content :global(h2) {
      margin-top: 3rem;
      margin-bottom: 1rem;
      color: var(--forest-dark);
      font-family: Georgia, 'Times New Roman', serif;
      font-size: clamp(1.6rem, 3vw, 2rem);
      font-weight: 600;
      line-height: 1.35;
      letter-spacing: -0.02em;
    }

    .article-content :global(h3) {
      margin-top: 2rem;
      margin-bottom: 0.75rem;
      color: #35483a;
      font-size: 1.25rem;
      font-weight: 650;
      line-height: 1.45;
    }

    .article-content :global(p) {
      margin: 1.1rem 0;
    }

    .article-content :global(a) {
      color: #49664d;
      text-decoration: underline;
      text-decoration-color: #b5c1b0;
      text-underline-offset: 3px;
    }

    .article-content :global(a:hover) {
      color: #26392d;
      text-decoration-color: currentColor;
    }

    .article-content :global(img) {
      display: block;
      width: auto;
      max-width: 100%;
      height: auto;
      margin: 2rem auto;
      border-radius: 12px;
    }

    .article-content :global(figure) {
      margin: 2.5rem 0;
    }

    .article-content :global(figure img) {
      margin: 0 auto;
    }

    .article-content :global(figcaption) {
      margin-top: 0.7rem;
      color: #7c8076;
      font-size: 0.8rem;
      line-height: 1.6;
      text-align: center;
    }

    .article-content :global(ul),
    .article-content :global(ol) {
      padding-left: 1.5rem;
      margin: 1.2rem 0;
    }

    .article-content :global(li) {
      padding-left: 0.3rem;
      margin: 0.45rem 0;
    }

    .article-content :global(blockquote) {
      padding: 0.75rem 1.25rem;
      margin: 2rem 0;
      border-left: 3px solid #82947c;
      background: #f1f2eb;
      color: #555f52;
    }

    .article-content :global(table) {
      display: block;
      width: 100%;
      overflow-x: auto;
      border-collapse: collapse;
      font-size: 0.9rem;
    }

    .article-content :global(th),
    .article-content :global(td) {
      padding: 0.75rem;
      border: 1px solid #e1e4da;
      text-align: left;
    }

    .article-content :global(th) {
      background: #edf0e8;
      color: var(--forest-dark);
    }

    .related-section {
      min-width: 0;
      margin-top: 5rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--line);
    }

    .related-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.75rem;
    }

    .related-heading-copy {
      min-width: 0;
    }

    .related-eyebrow {
      margin: 0 0 0.5rem;
      color: #71846c;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.16em;
    }

    .related-heading h2 {
      margin: 0;
      color: var(--forest-dark);
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 1.85rem;
      font-weight: 600;
      line-height: 1.3;
    }

    .related-subtitle {
      margin: 0.6rem 0 0;
      color: #777b72;
      font-size: 0.88rem;
      line-height: 1.7;
    }

    .related-controls {
      display: flex;
      flex-shrink: 0;
      gap: 0.5rem;
    }

    .related-arrow {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      border: 1px solid #d9dfd5;
      border-radius: 50%;
      background: #fff;
      color: var(--forest);
      font-size: 1.1rem;
      cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }

    .related-arrow:hover {
      border-color: var(--forest);
      background: var(--forest);
      color: #fff;
    }

    .related-arrow:focus-visible,
    .related-track:focus-visible {
      outline: 2px solid #71846c;
      outline-offset: 3px;
    }

    .related-track {
      display: flex;
      gap: 1.25rem;
      min-width: 0;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 0.25rem 0 1.1rem;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
      scrollbar-color: #aab6a5 #edf0e9;
    }

    .related-track::-webkit-scrollbar {
      height: 7px;
    }

    .related-track::-webkit-scrollbar-track {
      border-radius: 10px;
      background: #edf0e9;
    }

    .related-track::-webkit-scrollbar-thumb {
      border-radius: 10px;
      background: #aab6a5;
    }

    .related-card {
      display: flex;
      flex: 0 0 280px;
      flex-direction: column;
      min-width: 0;
      overflow: hidden;
      border: 1px solid #e6e8e1;
      border-radius: 13px;
      background: #fff;
      scroll-snap-align: start;
      transition: transform 0.25s, box-shadow 0.25s;
    }

    .related-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 28px rgb(38 57 45 / 8%);
    }

    .related-image-link {
      display: block;
      overflow: hidden;
      aspect-ratio: 16 / 10;
      background: #edf0e8;
    }

    .related-image-link img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s;
    }

    .related-card:hover .related-image-link img {
      transform: scale(1.04);
    }

    .related-image-placeholder {
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #e8ede4, #d5dfd0);
      color: #526951;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.13em;
    }

    .related-card-body {
      display: flex;
      flex: 1;
      flex-direction: column;
      align-items: flex-start;
      padding: 1.2rem;
    }

    .related-category {
      margin: 0 0 0.65rem;
      color: #647763;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .related-card h3 {
      margin: 0;
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 1.08rem;
      font-weight: 600;
      line-height: 1.5;
    }

    .related-card h3 a {
      color: var(--forest-dark);
      text-decoration: none;
    }

    .related-card h3 a:hover {
      color: #647763;
    }

    .related-description {
      display: -webkit-box;
      overflow: hidden;
      margin: 0.75rem 0 1rem;
      color: #777b72;
      font-size: 0.82rem;
      line-height: 1.7;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }

    .related-read-more {
      display: inline-flex;
      gap: 0.5rem;
      align-items: center;
      margin-top: auto;
      padding-top: 0.75rem;
      color: var(--forest);
      font-size: 0.8rem;
      font-weight: 700;
      text-decoration: none;
    }

    .related-scroll-hint {
      margin: 0.45rem 0 0;
      color: #85897f;
      font-size: 0.73rem;
    }

    .post-navigation {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 3.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--line);
    }

    .post-navigation-item {
      min-width: 0;
    }

    .post-navigation-next {
      text-align: right;
    }

    .post-nav-link {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      height: 100%;
      padding: 1.2rem;
      border: 1px solid #e5e7df;
      border-radius: 12px;
      background: rgb(255 255 255 / 55%);
      text-decoration: none;
      transition: border-color 0.2s, background 0.2s;
    }

    .post-nav-link:hover {
      border-color: #bdc9b8;
      background: #fff;
    }

    .post-nav-label {
      color: #77856f;
      font-size: 0.67rem;
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    .post-nav-title {
      display: -webkit-box;
      overflow: hidden;
      color: #354337;
      font-size: 0.9rem;
      font-weight: 600;
      line-height: 1.55;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    @media (min-width: 1500px) {
      .blog-shell {
        padding-inline: 3rem;
      }
    }

    @media (max-width: 1023px) {
      .blog-shell {
        padding: 1.5rem 1.5rem 4rem;
      }

      .blog-layout {
        display: block;
      }

      .sidebar-column {
        display: none;
      }

      .article-main {
        max-width: 820px;
        margin-inline: auto;
      }
    }

    @media (max-width: 640px) {
      .blog-shell {
        padding: 1.25rem 1rem 3rem;
      }

      .breadcrumb {
        gap: 0.45rem;
        margin-bottom: 1.75rem;
        font-size: 0.72rem;
      }

      .article-header {
        margin-bottom: 1.75rem;
        padding-bottom: 1.5rem;
      }

      .article-header h1 {
        font-size: clamp(2rem, 9vw, 2.7rem);
      }

      .article-deck {
        font-size: 1rem;
      }

      .article-content {
        font-size: 0.98rem;
        line-height: 1.85;
      }

      .article-content :global(h2) {
        margin-top: 2.3rem;
      }

      .related-section {
        margin-top: 3.5rem;
        padding-top: 2rem;
      }

      .related-heading {
        align-items: end;
        gap: 0.5rem;
      }

      .related-heading h2 {
        font-size: 1.5rem;
      }

      .related-subtitle {
        font-size: 0.8rem;
      }

      .related-card {
        flex-basis: 78%;
      }

      .related-arrow {
        width: 34px;
        height: 34px;
      }

      .related-controls {
        gap: 0.35rem;
      }

      .post-navigation {
        gap: 0.65rem;
      }

      .post-nav-link {
        padding: 0.9rem;
      }

      .post-nav-title {
        font-size: 0.82rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .related-track {
        scroll-behavior: auto;
      }

      .related-card,
      .related-image-link img,
      .related-arrow {
        transition: none;
      }
    }
  </style>
</Layout>
